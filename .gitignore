# Python and local environments.
.conda/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Notebooks and OS/editor files.
.ipynb_checkpoints/
.DS_Store

# Raw datasets and bulky generic exports.
data/
Corpora/
KuaiRand*/
*.tar
*.tar.gz
*.zip
*.parquet
*.csv

# Logs and temporary runtime outputs.
*.log
*.out
*.err
slurm-*.out
outputs/**/logs/
experiments/**/slurm_logs/*
!experiments/ltr_xgb_baseline/slurm_logs/.gitkeep

# Model binaries and dense arrays.
models/
experiments/**/model/
*.model
*.ubj
*.bin
*.ckpt
*.pt
*.pth
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# Large experiment artifacts stay on cHARISMa.
experiments/ltr_xgb_baseline/ltr_xgb_*/
experiments/ltr_xgb_baseline/*_sanity/
experiments/ltr_xgb_baseline/rankings/
experiments/ltr_xgb_baseline/features/
experiments/ltr_xgb_baseline/candidates/

# Keep compact experiment registry and run summaries.
!experiments/results.csv
experiments/ltr_xgb_baseline/runs/*
!experiments/ltr_xgb_baseline/runs/.gitkeep
!experiments/ltr_xgb_baseline/runs/*.json
!experiments/ltr_xgb_baseline/runs/*_notes.md

# Generated research outputs: ignore by default, keep compact summaries.
outputs/*
!outputs/.gitkeep
!outputs/eda/
outputs/eda/*
!outputs/eda/.gitkeep
!outputs/eda/27k_summary.json
!outputs/eda/27k_*.csv
outputs/eda/27k_sanity_*
!outputs/data/
outputs/data/*
!outputs/data/.gitkeep
!outputs/data/protocol_b_manifest.json
!outputs/data/protocol_b_stats.json
!outputs/data/protocol_b_validation_summary.csv
